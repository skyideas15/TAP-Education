{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tapedu.local/schemas/tapvocab-package-1.0.json",
  "title": "TAP Vocab offline package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "units", "entries", "assets"],
  "properties": {
    "schema_version": { "const": "tapvocab.package/1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "code": { "type": "string", "maxLength": 100 },
          "sort_order": { "type": "integer", "minimum": 0, "maximum": 1000000 }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "term", "meaning_vi"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "unit_key": { "$ref": "#/$defs/key" },
          "unit_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/key" }
          },
          "term": { "type": "string", "minLength": 1, "maxLength": 191 },
          "display": { "type": "string", "maxLength": 191 },
          "meaning_vi": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "primary_answer": { "type": "string", "maxLength": 191 },
          "accepted_answers": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 191 }
          },
          "part_of_speech": { "type": "string", "maxLength": 50 },
          "ipa": { "type": "string", "maxLength": 100 },
          "hint": { "type": "string", "maxLength": 255 },
          "mnemonic": { "type": "string", "maxLength": 10000 },
          "note": { "type": "string", "maxLength": 10000 },
          "examples": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["en"],
                  "properties": {
                    "en": { "type": "string" },
                    "vi": { "type": "string" }
                  }
                }
              ]
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 100 }
          },
          "image_asset_id": { "$ref": "#/$defs/key" },
          "audio_asset_id": { "$ref": "#/$defs/key" },
          "audio_variants": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_id"],
              "properties": {
                "asset_id": { "$ref": "#/$defs/key" },
                "label": { "type": "string", "maxLength": 60 },
                "accent": { "type": "string", "maxLength": 20 },
                "is_primary": { "type": "boolean" },
                "sort_order": { "type": "integer", "minimum": 0, "maximum": 100000 }
              }
            }
          }
        },
        "oneOf": [
          { "required": ["unit_key"] },
          { "required": ["unit_keys"] }
        ]
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind", "path", "mime", "sha256", "bytes"],
        "properties": {
          "id": { "$ref": "#/$defs/key" },
          "kind": { "enum": ["image", "audio"] },
          "path": {
            "type": "string",
            "pattern": "^assets/(images|audio)/[A-Za-z0-9._/-]+$"
          },
          "mime": {
            "enum": [
              "image/jpeg", "image/png", "image/webp", "image/gif",
              "audio/mpeg", "audio/wav", "audio/x-wav", "audio/ogg",
              "audio/mp4", "audio/aac", "audio/webm"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "alt_text": { "type": "string" },
          "language": { "type": "string" },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,189}$"
    }
  }
}
